# Copy this file to ".env" and fill it in. Never share or commit the .env file.

# Secret code teachers must type when they create a teacher account. Pick your own.
TEACHER_SIGNUP_CODE=change-me

# --- AI connection (used to read questions from PDFs and for the Explanation chat) ---
# Any OpenAI-compatible provider works. The defaults below use the Google Gemini free tier.
# Get a free key at https://aistudio.google.com/apikey and paste it here,
# or leave it empty and add it later in the app (Teacher > Settings).
AI_API_KEY=your-key-here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash

# --- Firebase (database) ---
# Firebase console > Project settings > Service accounts > Generate new private key.
# Save the downloaded file next to server.js and point to it here:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# On hosts without files (Render, Railway ...) paste the whole JSON on ONE line instead:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Local testing with the Firestore emulator only:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-examline

# --- Server ---
PORT=3000
# Set to 1 when running behind a proxy that provides HTTPS (Render, Railway, nginx, Caddy ...)
# TRUST_PROXY=1

# Local configuration. Git-ignored. Never share or commit this file.

# Secret code teachers must type when they create a teacher account.
# Generated for you; change it to anything you prefer.
TEACHER_SIGNUP_CODE=sVpmUz-oUDxb

# --- AI connection (reads questions from PDFs and powers the Explanation chat) ---
# Get a free key at https://aistudio.google.com/apikey and paste it below,
# or leave it empty and add it in the app later: Teacher > Settings.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash

# --- Firebase (database) ---
# Currently pointed at the LOCAL Firestore emulator, so the app runs with no
# Firebase account. Data lives in .emulator-data/ and is only on this machine.
# Start the emulator first, in its own terminal:
#   npx firebase emulators:start --only firestore --project demo-examline --import=.emulator-data --export-on-exit
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=demo-examline

# To switch to real Firebase for actual classroom use, comment out the two lines
# above and uncomment this one, after saving your downloaded key beside server.js.
# Firebase console > Project settings > Service accounts > Generate new private key.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# On hosts without a filesystem (Render, Railway ...) paste the whole JSON on ONE line instead:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Server ---
PORT=3000
# Set to 1 when running behind a proxy that terminates HTTPS (Render, Railway, nginx, Caddy ...)
# TRUST_PROXY=1
